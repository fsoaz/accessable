{
  "name": "accessable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env src/server/main.ts",
    "dev": "npm run build && npm start",
    "agent": "node --env-file-if-exists=.env node_modules/eve/bin/eve.js dev --no-ui --no-default-extensions --host 127.0.0.1 --port 3412",
    "test": "npm run build && node --test test/*.test.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "4.11.1",
    "diff": "8.0.2",
    "eve": "1.1.0",
    "parse5": "8.0.1",
    "playwright-core": "1.65.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4"
  }
}
